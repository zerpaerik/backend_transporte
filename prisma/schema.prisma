// Schema del sistema de gestión de transporte de carga pesada.
// Los campos de "estado/tipo" se guardan como texto para coincidir exactamente
// con las cadenas que usa el frontend (p. ej. "En taller", "N. Crédito").
// La validación de valores permitidos se hace en los DTO (class-validator).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sede {
  id        String   @id @default(uuid())
  codigo    String   @unique // "mgr" | "mjg" | "mgrsi"
  nombre    String
  ruc       String
  orden     Int      @default(0)
  sueldoDia Float    @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sedes")
}

model Usuario {
  id       String  @id @default(uuid())
  nombre   String
  email    String  @unique
  password String
  rol      String  @default("Operador") // Administrador | Operador | Mecánico
  activo   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model Vehiculo {
  id          String @id @default(uuid())
  placa       String
  tipo        String // Tracto | Carreta
  marca       String
  modelo      String
  anio        Int
  kilometraje Int    @default(0)
  estado      String @default("Operativo") // Operativo | En taller | Inactivo
  constanciaTuc String @default("") // Certificado/TUC del vehículo para la GRE (CONSTANCIA_VEHICULAR_TUC)

  documentos DocumentoVehiculo[]

  foto     Bytes?
  fotoMime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@unique([sedeId, placa])
  @@index([sedeId])
  @@map("vehiculos")
}

model Conductor {
  id              String               @id @default(uuid())
  nombre          String
  licencia        String
  dni             String               @default("") // para la GRE (NUM_NIF_CONDUCT)
  categoria       String
  telefono         String
  descuentoMensual Float                @default(0)
  documentos       DocumentoConductor[]

  foto     Bytes?
  fotoMime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("conductores")
}

model DocumentoConductor {
  id            String    @id @default(uuid())
  tipo          String
  numero        String
  vencimiento   DateTime  @db.Date
  archivo       Bytes?
  archivoNombre String?
  archivoMime   String?
  conductor     Conductor @relation(fields: [conductorId], references: [id], onDelete: Cascade)
  conductorId   String

  @@map("documentos_conductor")
}

model DocumentoVehiculo {
  id            String   @id @default(uuid())
  tipo          String
  numero        String   @default("")
  vencimiento   DateTime @db.Date
  archivo       Bytes?
  archivoNombre String?
  archivoMime   String?
  vehiculo      Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  vehiculoId    String

  @@index([vehiculoId])
  @@map("documentos_vehiculo")
}

model TipoOperacion {
  id        String   @id @default(uuid())
  nombre    String
  sedeId    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("tipos_operacion")
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  ruc       String   @default("")
  email     String   @default("")
  telefono  String   @default("")
  contacto  String   @default("")
  direccion String   @default("")
  sedeId    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("clientes")
}

model Puerto {
  id        String   @id @default(uuid())
  nombre    String
  sedeId    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("puertos")
}

model Agenda {
  id          String   @id @default(uuid())
  fecha       DateTime @db.Date // día del servicio agendado
  cliente     String
  origen      String   @default("") // desde dónde sale la carga (puerto)
  destino     String   @default("") // a dónde va la carga (distrito)
  devolucion  String   @default("") // dónde se devuelve
  tipoCarga   String   @default("GENERAL") // GENERAL | IMO | REEFER
  tipoCarreta String   @default("") // tipo de carreta requerida (plataforma, portacontenedor, cama baja…)
  unidades    Int      @default(1) // unidades comprometidas
  observacion String   @default("")
  estado      String   @default("Programado") // Programado | Confirmado | Realizado | Cancelado
  sedeId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sedeId])
  @@map("agenda")
}

model Peaje {
  id        String   @id @default(uuid())
  destino   String
  ejes      Int      @default(0)
  monto     Float    @default(0)
  sedeId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("peajes")
}

model Proveedor {
  id          String   @id @default(uuid())
  razonSocial String
  ruc         String   @default("")
  direccion   String   @default("")
  contacto    String   @default("")
  telefono    String   @default("")
  sedeId      String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sedeId])
  @@map("proveedores")
}

model Comision {
  id        String   @id @default(uuid())
  destino   String // distrito
  gral      Float    @default(0)
  imo       Float    @default(0)
  reefer    Float    @default(0)
  sedeId    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("comisiones")
}

model Planilla {
  id                String              @id @default(uuid())
  sedeId            String
  conductor         String
  semanaDesde       DateTime            @db.Date
  semanaHasta       DateTime            @db.Date
  sueldoDia         Float               @default(0)
  descuentoPlanilla Float               @default(0) // heredado: migrado a "descuentos"
  estado            String              @default("Borrador") // Borrador | Generada | Aprobada | Pagada
  aprobadaPor       String              @default("") // usuario que aprobó antes de pagar
  aprobadaEn        DateTime? // cuándo se aprobó
  lineas            PlanillaLinea[]
  descuentos        PlanillaDescuento[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sedeId])
  @@map("planillas")
}

model PlanillaLinea {
  id         String   @id @default(uuid())
  planilla   Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  planillaId String
  fecha      DateTime @db.Date
  cliente    String   @default("")
  origen     String   @default("")
  destino    String   @default("")
  sueldoDia  Float    @default(0)
  comision   Float    @default(0)
  viaticos   Float    @default(0)
  concepto   String   @default("")
  viajeId    String   @default("")
  orden      Int      @default(0)

  @@index([planillaId])
  @@map("planilla_lineas")
}

model PlanillaDescuento {
  id         String   @id @default(uuid())
  planilla   Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  planillaId String
  concepto   String   @default("")
  monto      Float    @default(0)
  orden      Int      @default(0)

  @@index([planillaId])
  @@map("planilla_descuentos")
}

model OrdenTrabajo {
  id          String   @id @default(uuid())
  fecha       DateTime @db.Date
  placa       String
  tipo        String // Preventivo | Correctivo | Predictivo
  descripcion String
  responsable String
  conductor   String
  kilometraje Int      @default(0)
  costo       Float    @default(0)
  estado      String   @default("Abierta") // Abierta | En proceso | Cerrada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("ordenes_trabajo")
}

model Repuesto {
  id        String   @id @default(uuid())
  nombre    String
  categoria String
  calidad   String // Original | Alternativo | Remanufacturado
  placa     String   @default("") // vehículo (tracto o carreta) al que pertenece
  kilometraje Int    @default(0)
  cantidad  Int      @default(1)
  garantia  String
  proveedor String
  costo     Float    @default(0)
  fecha     DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("repuestos")
}

model Neumatico {
  id            String @id @default(uuid())
  placa         String
  posicion      String
  marca         String
  kmInstalacion Int    @default(0)
  kmActual      Int    @default(0)
  costo         Float  @default(0)
  tienda        String
  estado        String @default("Nuevo") // Nuevo | En uso | Para rotar | Reencauche | Descartado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("neumaticos")
}

model Viaje {
  id            String   @id @default(uuid())
  placaTracto   String
  carreta       String    @default("")
  conductor     String    @default("")
  cliente       String // cliente que SOLICITA el servicio (p. ej. agencia de aduana)
  clienteFactura String   @default("") // a quién se factura; si vacío, se factura al solicitante
  operacion     String // IMPO | EXPO | Carga suelta
  contenedor    String
  tamanio       String    @default("")
  tipoCarga     String    @default("")
  horaCita      String    @default("")
  fechaViaje    DateTime? @db.Date // fecha del viaje, ingresada a mano (independiente del registro)
  memo          DateTime? @db.Date // vencimiento del MEMO (alerta 72h antes)
  observacion   String    @default("") // notas libres del viaje
  fechaCliente  DateTime? @db.Date // fecha en la que debe estar en el cliente
  horaCliente   String    @default("") // hora en la que debe estar en el cliente
  origen        String    @default("")
  destino       String    @default("")
  devolucion    String    @default("")
  ubicacion     String    @default("")
  fechaLimite   DateTime? @db.Date
  estado        String    @default("Programado") // Programado | En curso | Culminado | Devuelto
  codigo        String    @default("")
  clienteRuc    String    @default("")
  clienteDireccion String @default("")
  tarifa        Float     @default(0)
  comisionChofer Float    @default(0)
  comisionPagada Boolean  @default(false)
  comisionFechaPago DateTime? @db.Date
  nOrden        String    @default("")
  greRemitente  String    @default("")
  greTransporte String    @default("")
  factura       String    @default("")

  // Control de devolución de contenedores (solo aplica a importación)
  citaFecha           DateTime? @db.Date
  citaHora            String    @default("")
  lugarGuardado       String    @default("")
  estadoDevolucion    String    @default("Pendiente") // Pendiente | En proceso | Devuelto
  devueltoEn          DateTime? // cuándo pasó a "Devuelto" (para archivar a los 15 días)
  // Quién devolvió el contenedor. Si es distinto del conductor del viaje, queda una
  // compensación: el conductor dueño le debe una devolución al que la hizo.
  devueltoPor         String    @default("")
  devueltoPorEn       DateTime? // cuándo se registró la devolución cruzada (para el seguimiento y el orden)
  compensacionEstado  String    @default("") // "" (no aplica) | Pendiente | Compensada | Pagada
  compensacionMonto   Float     @default(0)  // monto pagado al que hizo la devolución (opcional)
  compensacionNota    String    @default("") // p. ej. "compensada con OP-0123" o detalle del pago
  compensacionEn      DateTime? // cuándo se saldó (se compensó o se pagó); útil para la planilla
  devolucionArchivada Boolean   @default(false) // se quita del índice de devoluciones (no de operaciones)
  citaArchivos        CitaArchivo[]
  // Adjunto único legado (reemplazado por citaArchivos)
  citaArchivo       Bytes?
  citaArchivoNombre String?
  citaArchivoMime   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("viajes")
}

// Gestor documental: carpetas anidadas + archivos, por sede.
model Carpeta {
  id        String    @id @default(uuid())
  sedeId    String
  nombre    String
  parentId  String? // null = carpeta raíz
  parent    Carpeta?  @relation("CarpetaHijos", fields: [parentId], references: [id], onDelete: Cascade)
  hijos     Carpeta[] @relation("CarpetaHijos")
  archivos  Archivo[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sedeId])
  @@index([parentId])
  @@map("carpetas")
}

model Archivo {
  id        String   @id @default(uuid())
  sedeId    String
  carpetaId String
  carpeta   Carpeta  @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  nombre    String
  mime      String   @default("application/octet-stream")
  size      Int      @default(0)
  data      Bytes
  createdAt DateTime @default(now())

  @@index([sedeId])
  @@index([carpetaId])
  @@map("archivos")
}

model Combustible {
  id              String   @id @default(uuid())
  fecha           DateTime @db.Date
  placa           String // vehículo (tracto o carreta)
  tipoCombustible String   @default("Diésel") // Diésel | Gasolina | GNV | GLP
  kilometraje     Int      @default(0) // odómetro al momento de cargar
  galones         Float    @default(0)
  monto           Float    @default(0) // soles
  tipoPago        String   @default("") // Transferencia | Efectivo | Crédito | Vale
  observacion     String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("combustible")
}

model CitaArchivo {
  id        String   @id @default(uuid())
  viaje     Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  viajeId   String
  nombre    String
  mime      String   @default("application/pdf")
  archivo   Bytes
  createdAt DateTime @default(now())

  @@index([viajeId])
  @@map("cita_archivos")
}

model LugarGuardado {
  id        String   @id @default(uuid())
  nombre    String
  sedeId    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("lugares_guardado")
}

model Factura {
  id          String   @id @default(uuid())
  serie       String
  tipo        String // Factura | Boleta | N. Crédito
  cliente     String
  ruc         String   @default("-")
  direccion   String   @default("")
  fecha       DateTime @db.Date
  viaje       String   @default("-")
  monto       Float    @default(0)
  igv         Float    @default(0)
  estadoSunat String   @default("Emitida") // Emitida | Aceptada | Pagada | Anulada

  // --- Facturación electrónica (MiFact / SUNAT) — aditivo, no rompe lo anterior ---
  tipoDocCodigo     String    @default("01") // 01 factura · 03 boleta · 07 NC · 08 ND
  correlativo       String    @default("") // número dentro de la serie (lo controla el sistema)
  moneda            String    @default("PEN")
  tipoCambio        Float     @default(0) // solo si moneda != PEN
  gravado           Float     @default(0)
  exonerado         Float     @default(0)
  inafecto          Float     @default(0)
  total             Float     @default(0)
  // Detracción (SPOT) — transporte de carga
  sujetoDetraccion  Boolean   @default(false)
  porcDetraccion    Float     @default(0)
  montoDetraccion   Float     @default(0)
  codDetraccion     String    @default("") // 027 transporte de carga
  ctaDetraccion     String    @default("")
  valorReferencial  Float     @default(0) // valor referencial del transporte (base alterna de la detracción)
  // Insumos para calcular el valor referencial desde las tablas del DS 022-2025-MTC
  vrAmbito          String    @default("") // "" | local | nacional
  vrRuta            String    @default("") // ámbito nacional: ruta del DS
  vrDestino         String    @default("") // ámbito nacional: destino del DS
  vrPuerto          String    @default("") // ámbito local: puerto
  vrZona            String    @default("") // ámbito local: zona
  vrTipoCarga       String    @default("") // contenedorLleno | contenedorVacio | cargaGeneral | granelAlimentos | granelMinerales
  pesoTM            Float     @default(0) // peso transportado en toneladas
  referenciaVR      String    @default("") // referencia / N° de orden de compra
  guia              String    @default("") // guía de remisión del remitente referenciada (SERIE-CORRELATIVO)
  guiaTransportista String    @default("") // guía de remisión del transportista referenciada (SERIE-CORRELATIVO)
  ubigeoOrigen      String    @default("") // COD_UBI_PRTD (bloque transporte)
  ubigeoDestino     String    @default("") // COD_UBI_LLGD (bloque transporte)
  origen            String    @default("") // dirección/lugar de partida (TXT_DMCL_FISC_PRTD)
  destino           String    @default("") // dirección/lugar de llegada (TXT_DMCL_FISC_LLGD)
  detalleViaje      String    @default("") // DETALLE_VIAJE (detracción transporte)
  observaciones     String    @default("") // texto libre que sale en "Observaciones" del comprobante (p. ej. la DAM)
  // Forma de pago
  formaPago         String    @default("Contado") // Contado | Credito
  fechaVencimiento  DateTime? @db.Date
  items             FacturaItem[]
  serviciosVR       FacturaServicioVR[]
  // Cobranza (control de pago, independiente del estado SUNAT)
  pagada            Boolean   @default(false)
  fechaPago         DateTime? @db.Date
  notaPago          String    @default("") // banco, n° de operación, etc.
  comprobantesPago  FacturaComprobantePago[]
  // Respuesta SUNAT / MiFact
  estadoDocumento   String    @default("") // 101 proceso · 102 aceptado · 103 obs · 104 rechazado · 105 anulado · 108 baja
  sunatDescripcion  String    @default("")
  sunatResponsecode String    @default("")
  hash              String    @default("") // codigo_hash
  qr                String    @default("") // cadena_para_codigo_qr
  ticket            String    @default("")
  emitidoEn         DateTime? // cuándo se envió a SUNAT
  // Archivos (CDR + XML se guardan siempre; PDF on-demand vía GetInvoice)
  xml               String? // xml_enviado
  cdr               String? // cdr_sunat
  // Referencia para NC/ND
  docRefTipo        String    @default("")
  docRefSerie       String    @default("")
  docRefCorrelativo String    @default("")
  codTipNc          String    @default("") // código de motivo de la nota de crédito/débito (catálogo 09/10 SUNAT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("facturas")
}

// Líneas de una factura electrónica (una factura puede tener varias).
model FacturaItem {
  id            String  @id @default(uuid())
  factura       Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  facturaId     String
  descripcion   String  @default("")
  cantidad      Float   @default(1)
  valorUnitario Float   @default(0) // sin IGV
  afectacion    String  @default("10") // 10 gravado · 20 exonerado · 30 inafecto
  unidad        String  @default("ZZ") // ZZ = servicios
  orden         Int     @default(0)

  @@index([facturaId])
  @@map("factura_items")
}

// Valor referencial de CADA servicio (viaje) incluido en el comprobante: el valor
// referencial de la factura es la suma de estos. Se guardan también los insumos del
// cálculo para poder recalcular cada servicio desde las tablas del DS 022-2025-MTC
// al momento de emitir, igual que se hace con el valor referencial único.
// Comprobante de pago de una factura (captura/voucher en JPG/PNG o PDF).
model FacturaComprobantePago {
  id        String   @id @default(uuid())
  factura   Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  facturaId String
  nombre    String   @default("comprobante")
  mime      String   @default("application/octet-stream")
  archivo   Bytes
  createdAt DateTime @default(now())

  @@index([facturaId])
  @@map("factura_comprobantes_pago")
}

model FacturaServicioVR {
  id        String  @id @default(uuid())
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  facturaId String
  detalle   String  @default("") // cómo se calculó / a qué viaje corresponde
  valor     Float   @default(0) // S/ del servicio
  ambito    String  @default("") // "" manual | local | nacional
  ruta      String  @default("") // ámbito nacional
  destino   String  @default("") // ámbito nacional
  puerto    String  @default("") // ámbito local
  zona      String  @default("") // ámbito local
  tipoCarga String  @default("") // ámbito local
  pesoTM    Float   @default(0)
  orden     Int     @default(0)

  @@index([facturaId])
  @@map("factura_servicios_vr")
}

// Datos del emisor por sede (editable desde el portal).
// El TOKEN, el AMBIENTE y la URL base NO viven aquí: son variables de entorno del
// servidor (seguridad — nadie pasa a producción desde el portal).
model EmisorConfig {
  id               String   @id @default(uuid())
  sedeId           String   @unique
  ruc              String   @default("")
  razonSocial      String   @default("")
  nombreComercial  String   @default("")
  ubigeo           String   @default("") // COD_UBI_EMIS (6 dígitos del distrito)
  direccionFiscal  String   @default("")
  codAnexo         String   @default("0000") // COD_ANEXO_EMIS
  serieFactura     String   @default("FN01")
  serieBoleta      String   @default("BN01")
  serieNotaCredito String   @default("FN01") // NC referida a factura
  serieNotaDebito  String   @default("FD01") // ND referida a factura
  serieGuiaTransportista String @default("V001") // serie de la GRE del transportista
  registroMtc      String   @default("") // NRO_REGISTRO_MTC del transportista (GRE)
  puntoVenta       String   @default("") // COD_PTO_VENTA
  ctaDetraccion    String   @default("") // NRO_CUENTA_DETRAC (Banco de la Nación)
  porcDetraccion   Float    @default(4) // POR_DETRACCION
  codDetraccion    String   @default("027") // COD_TIP_DETRACCION (transporte de carga)
  umbralDetraccion Float    @default(400) // detracción solo si el total supera este monto
  formatoImpresion String   @default("001") // COD_FORM_IMPR: formato del PDF en MiFact (001 básico o el personalizado)
  correoEnvio      String   @default("") // copia opcional al emitir
  activo           Boolean  @default(false) // habilita la emisión electrónica para la sede
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("emisor_config")
}

// Cuentas bancarias de la sede que se muestran/envían en los comprobantes para que
// el cliente pague. La cuenta de detracción va aparte, en EmisorConfig.
model CuentaBancaria {
  id        String   @id @default(uuid())
  sedeId    String
  banco     String   @default("")
  moneda    String   @default("Soles") // Soles | Dólares
  numero    String   @default("")
  cci       String   @default("")
  tipo      String   @default("Corriente") // Corriente | Ahorros
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sedeId])
  @@map("cuentas_bancarias")
}

// Correlativo por (sede, tipo de comprobante, serie). El sistema lo controla en
// transacción para no duplicar ni saltar números.
model Correlativo {
  id        String   @id @default(uuid())
  sedeId    String
  tipoDoc   String // 01 · 03 · 07 · 08
  serie     String
  siguiente Int      @default(1) // próximo correlativo a emitir
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, tipoDoc, serie])
  @@map("correlativos")
}

// Guía de Remisión electrónica del transportista, por viaje.
model GuiaTransportista {
  id                String    @id @default(uuid())
  sedeId            String
  viajeId           String
  serie             String    @default("")
  correlativo       String    @default("")
  tipoGur           String    @default("31")
  fechaEmision      DateTime? @db.Date
  fechaTraslado     DateTime? @db.Date
  partidaDir        String    @default("")
  partidaUbigeo     String    @default("")
  llegadaDir        String    @default("")
  llegadaUbigeo     String    @default("")
  remitenteRuc      String    @default("")
  remitenteRazon    String    @default("")
  destinatarioRuc   String    @default("")
  destinatarioRazon String    @default("")
  conductorNombre   String    @default("")
  conductorDni      String    @default("")
  conductorLicencia String    @default("")
  placaTracto       String    @default("")
  tucTracto         String    @default("")
  placaCarreta      String    @default("")
  tucCarreta        String    @default("")
  pesoBruto         Float     @default(0)
  unidad            String    @default("KGM")
  docRefTipo        String    @default("09") // 09 GRR · 01 factura
  docRefNumero      String    @default("")
  pagadorFlete      String    @default("remitente") // remitente | tercero | subcontratado
  terceroRuc        String    @default("")
  terceroRazon      String    @default("")
  trasladoTotal     Boolean   @default(true)
  observaciones     String    @default("")
  itemsJson         String    @default("[]") // mercadería (si no la jala SUNAT desde la GRR)
  // Respuesta SUNAT / MiFact
  estadoDocumento   String    @default("")
  sunatDescripcion  String    @default("")
  hash              String    @default("")
  cdr               String?
  xml               String?
  emitidoEn         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sedeId])
  @@index([viajeId])
  @@map("guias_transportista")
}

model Empleado {
  id         String @id @default(uuid())
  nombre     String
  cargo      String
  tipo       String // Chofer | Administrativo
  sueldoBase Float  @default(0)
  bonos      Float  @default(0)
  descuentos Float  @default(0)
  periodo    String
  estadoPago String @default("Pendiente") // Pendiente | Pagado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedeId String

  @@index([sedeId])
  @@map("empleados")
}
