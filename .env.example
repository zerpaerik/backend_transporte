# Conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transporte?schema=public"

# Autenticación
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"

# Servidor
PORT=3001

# CORS: origen del frontend (usa * para permitir todos en demo)
FRONTEND_URL="*"

# --- Facturación electrónica (MiFact / SUNAT) ---
# Candado de producción: mientras sea "demo" NO se envía nada real a SUNAT.
MIFACT_AMBIENTE="demo"                                                  # demo | prod
# DEMO (valores públicos de la documentación)
MIFACT_BASE_URL_DEMO="https://demo.mifact.net.pe/api/invoiceService.svc/"
MIFACT_TOKEN_DEMO="gN8zNRBV+/FVxTLwdaZx0w=="
# PRODUCCIÓN — la URL es la misma para todas las empresas.
MIFACT_BASE_URL_PROD="https://mifact.net.pe/mifactapi48/invoiceService.svc/"
# Cada empresa (RUC) tiene su PROPIO token de producción. Lo normal es cargarlo en la pantalla
# "Datos del emisor" de cada sede (se verifica con MiFact al guardarlo y nunca se muestra).
# Si una empresa no lo tiene cargado ahí, se busca en estas variables (opcional):
#   MIFACT_TOKEN_<RUC>   p. ej. MIFACT_TOKEN_20614975831=""
#   MIFACT_TOKEN_MGRSI   variable histórica: solo vale para MGR Servicios Integrados (RUC 20616110340)
MIFACT_TOKEN_MGRSI=""
# GRE — Guía de Remisión del transportista (GuiaRemision.svc). Usa el mismo token del RUC.
# DEMO: URL pública del repositorio de MiFact (si se deja vacío, el sistema usa esta por defecto).
MIFACT_GRE_BASE_URL_DEMO="https://demo.mifact.net.pe/api/GuiaRemision.svc/"
# PRODUCCIÓN: MiFact entrega otra URL al pasar a prod (los métodos son los mismos).
MIFACT_GRE_BASE_URL_PROD=""
